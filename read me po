def init_db():
    conn = sqlite3.connect(str(DB_PATH))

    conn.execute("""
        CREATE TABLE IF NOT EXISTS facilities (
            id INTEGER PRIMARY KEY AUTOINCREMENT,
            name TEXT NOT NULL,
            location TEXT NOT NULL,
            contact TEXT NOT NULL,
            patients INTEGER NOT NULL DEFAULT 0,
            total_beds INTEGER NOT NULL DEFAULT 0,
            icu_beds INTEGER NOT NULL DEFAULT 0,
            general_beds INTEGER NOT NULL DEFAULT 0,
            last_updated TEXT NOT NULL
        )
    """)

    conn.commit()
    conn.close()

def load_facilities():
    conn = sqlite3.connect(str(DB_PATH))
    conn.row_factory = sqlite3.Row

    rows = conn.execute(
        "SELECT * FROM facilities ORDER BY id DESC"
    ).fetchall()

    conn.close()

    return [dict(row) for row in rows]

def save_facility(data, record_id=None):
    conn = sqlite3.connect(str(DB_PATH))
    now = datetime.now().strftime("%Y-%m-%d %H:%M")

    if record_id is not None:
        conn.execute("""
            UPDATE facilities
            SET name = ?,
                location = ?,
                contact = ?,
                patients = ?,
                total_beds = ?,
                icu_beds = ?,
                general_beds = ?,
                last_updated = ?
            WHERE id = ?
        """, (
            data["name"],
            data["location"],
            data["contact"],
            data["patients"],
            data["total_beds"],
            data["icu_beds"],
            data["general_beds"],
            now,
            record_id,
        ))
    else:
        conn.execute("""
            INSERT INTO facilities (
                name,
                location,
                contact,
                patients,
                total_beds,
                icu_beds,
                general_beds,
                last_updated
            )
            VALUES (?, ?, ?, ?, ?, ?, ?, ?)
        """, (
            data["name"],
            data["location"],
            data["contact"],
            data["patients"],
            data["total_beds"],
            data["icu_beds"],
            data["general_beds"],
            now,
        ))

    conn.commit()
    conn.close()

def delete_facility(record_id):
    conn = sqlite3.connect(str(DB_PATH))

    conn.execute(
        "DELETE FROM facilities WHERE id = ?",
        (record_id,),
    )

    conn.commit()
    conn.close()

